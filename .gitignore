# Custom
*.v[0-9]*
tmp/

# Keys: the GitHub App private key lives only in the Worker secret GITHUB_APP_KEY
*.pem

# Dependencies
node_modules/

# Generated output
build/
dist/
platforms/desktop/app/
platforms/desktop/out/

# Cloudflare
.wrangler/
.dev.vars

# Database dumps contain user data and must never be committed
*.sql.gz
*.sql
# Schema migrations and the test fixture of an older schema are code, not dumps.
!worker/media/migrations/*.sql
!tests/fixtures/schema-*.sql
!worker/media/schema.sql

# Environment and editors
.env
.vscode/
.idea/
.DS_Store
*.log
