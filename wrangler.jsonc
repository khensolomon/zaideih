// The web app on Cloudflare: Workers static assets serving dist/web.
//
// No Worker code runs: Cloudflare serves the built files and applies
// dist/web/_headers (CSP and caching). The release workflow builds dist/web
// and runs `wrangler deploy` with this file (docs/releasing.md).
//
// The site is served at https://zaideih.<account subdomain>.workers.dev.
// zaideih.com is to be attached as a custom domain in the Cloudflare
// dashboard when the switch is intended, not as routes in this file: routes
// here make every deploy look up the zaideih.com zone, which would need zone
// permissions on the release workflow's token (docs/releasing.md).
{
	"name": "zaideih",
	"compatibility_date": "2026-05-01",
	"assets": {
		"directory": "./dist/web",
		"not_found_handling": "none"
	},
	"workers_dev": true
}
