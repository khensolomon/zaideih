{
	"name": "zaideih",
	"version": "26.10.22.2",
	"private": true,
	"description": "Zaideih Music Station: offline-first music app for web (PWA) and desktop (Electron).",
	"type": "module",
	"scripts": {
		"catalog": "node tools/catalog.mjs",
		"catalog:apply": "node tools/catalog.mjs --apply",
		"media:check": "node tools/media.mjs check",
		"build": "node tools/catalog.mjs --apply && node tools/build.mjs --platform web",
		"build:web": "node tools/build.mjs --platform web",
		"build:desktop": "node tools/build.mjs --platform desktop",
		"dev": "node tools/dev.mjs",
		"preview": "npm run build && node tools/serve.mjs --dir dist/web",
		"desktop": "npm --prefix platforms/desktop start",
		"version:next": "node tools/version.mjs",
		"test": "node --test tests/*.test.mjs",
		"diagnose": "node tools/diagnose.mjs"
	},
	"devDependencies": {
		"esbuild": "0.25.10"
	},
	"engines": {
		"node": ">=20"
	},
	"homepage": "https://github.com/khensolomon/zaideih#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/khensolomon/zaideih.git"
	},
	"license": "MIT",
	"author": "Khen Solomon Lethil"
}
